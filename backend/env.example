# Porta del server
PORT=3007

# LUKSO
LUKSO_RPC_URL=https://explorer.execution.mainnet.lukso.network/api/eth-rpc
CONTRACT_ADDRESS=0xf3D944E7061E896352C9082fe7866Ddbd436398d
OWNER_UP_ADDRESS=0x4a2605796e0d91A9667d6E30365aEEC384C48c27

# Nodo IPFS proprio (Kubo) — sostituisce Pinata. Nessuna chiave: la
# sicurezza è la whitelist IP configurata sul nodo stesso, non un segreto
# da mettere qui. URL reale non incluso in questo template pubblico.
IPFS_API_URL=

# Chiavi private (mai committare il .env reale!)
SPONSOR_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=

# Cifratura chiavi utenti — genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT — genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@chainintegrate.it

# Frontend URL (usato per CORS e link nel magic link)
FRONTEND_URL=https://playmatchpredictor.chainintegrate.it

# football-data.org
FOOTBALL_DATA_API_KEY=
